require 'lib.moonloader'
local sampev = require 'lib.samp.events'
local inicfg = require 'inicfg'

-- 1. ЛОКАЛИЗАЦИЯ ГЛОБАЛЬНЫХ ФУНКЦИЙ (Кэширование)
-- Локальные переменные в Lua вызываются значительно быстрее, чем глобальные.
local os_clock = os.clock
local math_floor = math.floor
local math_ceil = math.ceil
local math_min = math.min
local tostring = tostring
local getCharHealth = getCharHealth
local wasKeyPressed = wasKeyPressed
local sampIsCursorActive = sampIsCursorActive
local sampSendChat = sampSendChat
local renderFontDrawText = renderFontDrawText

local IniFilename = 'DrugsTimer.ini'
local ini = inicfg.load({
    DrugsTimer = {
        cooldown = 60
    }
}, IniFilename)
inicfg.save(ini, IniFilename)

-- 2. РАСПАКОВКА ТАБЛИЦЫ КОНФИГУРАЦИИ
-- Прямое обращение к локальной переменной быстрее, чем поиск ключа в таблице (CONFIG.MAX_HP).
local MAX_HP = 160
local HP_PER_DRUG = 10
local MAX_DRUGS = 15
local TIMER_X = 2440
local TIMER_Y = 216
local COLOR_WHITE = 0xFFFFFFFF
local VK_X = 0x58 -- Задаем напрямую, чтобы избежать глобального поиска

local timerFont = renderCreateFont('Inter 28pt ExtraBold', 12, 12)
local timerText = 'Use!'
local timerActive = false
local timerStart = 0
local lastSecond = -1
local wasDead = false

-- 3. ПРЕДВАРИТЕЛЬНОЕ СОЗДАНИЕ СТРОК ДЛЯ ПОИСКА
local searchMsgMale = ''
local searchMsgFemale = ''
local searchMsgHp = '(( Здоровье пополнено до'

local function calculateDrugsNeeded(currentHp)
    if currentHp <= 0 then return 0 end
    local drugs = math_ceil((MAX_HP - currentHp) / HP_PER_DRUG + 1)
    return math_min(drugs, MAX_DRUGS)
end

function main()
    while not isSampAvailable() do wait(0) end

    local _, playerId = sampGetPlayerIdByCharHandle(PLAYER_PED)
    local nickname = sampGetPlayerNickname(playerId)
    
    -- Инициализируем строки ровно один раз, чтобы избежать склейки (..) в хуке
    searchMsgMale = nickname .. ' употребил субстанцию'
    searchMsgFemale = nickname .. ' употребила субстанцию'

    sampRegisterChatCommand('dtsec', function(arg)
        local sec = tonumber(arg)
        if sec and sec > 0 and sec <= 300 then
            ini.DrugsTimer.cooldown = sec
            inicfg.save(ini, IniFilename)
            sampAddChatMessage(string.format('{69d1d1}[DrugTimer] {dddddd}Новая продолжительность таймера {69d1d1}%d {dddddd}секунд', sec), COLOR_WHITE)
        else
            sampAddChatMessage('{69d1d1}[DrugTimer] {dddddd}Используй: /dtsec [секунды]', COLOR_WHITE)
        end
    end)

    while true do
        wait(0)
        
        local hp = getCharHealth(PLAYER_PED)
        local isDead = (hp <= 0)

        if timerActive then
            local timeLeft = ini.DrugsTimer.cooldown - math_floor(os_clock() - timerStart)
            
            if timeLeft >= 0 then
                if timeLeft ~= lastSecond then
                    timerText = tostring(timeLeft)
                    lastSecond = timeLeft
                end
            else
                timerActive = false
                timerText = 'Use!'
            end
        end -- Убрали постоянное присваивание timerText = 'Use!', если таймер не активен

        if wasKeyPressed(VK_X) and not sampIsCursorActive() and not timerActive then
            if hp > 0 then
                local drugs = calculateDrugsNeeded(hp)
                if drugs > 0 then
                    sampSendChat('/usedrugs ' .. drugs)
                end
            end
        end

        if isDead and not wasDead then
            sampSendChat('/usedrugs ' .. MAX_DRUGS)
            timerActive = false
            timerText = 'Use!' -- Сбрасываем текст при смерти
        end
        wasDead = isDead
    end
end

function onD3DPresent()
    -- Отрисовка происходит каждый кадр, поэтому локализация функций здесь критически важна
    renderFontDrawText(timerFont, timerText, TIMER_X, TIMER_Y, COLOR_WHITE)
end

function onScriptTerminate(scr, quitGame)
    if scr == thisScript() then
        if timerFont then
            renderReleaseFont(timerFont)
        end
    end
end

function sampev.onServerMessage(color, text)
    if timerActive or getCharHealth(PLAYER_PED) <= 0 then return end
    
    -- 4. ИСПОЛЬЗОВАНИЕ PLAIN SEARCH (ПРЯМОЙ ПОИСК)
    -- Добавление 1, true в string.find отключает регулярные выражения (pattern matching)
    -- Это делает поиск по строке невероятно быстрым.
    if text:find(searchMsgMale, 1, true) or 
       text:find(searchMsgFemale, 1, true) or
       text:find(searchMsgHp, 1, true) then
        timerStart = os_clock()
        timerActive = true
        lastSecond = -1
    end
end
