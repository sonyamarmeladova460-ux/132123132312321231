local function join_argb(a, r, g, b)
	local argb = b  -- b
	argb = bit.bor(argb, bit.lshift(g, 8))  -- g
	argb = bit.bor(argb, bit.lshift(r, 16)) -- r
	argb = bit.bor(argb, bit.lshift(a, 24)) -- a
	return argb
end

function main()
	if not isSampLoaded() or not isSampfuncsLoaded() then return end
	while not isSampAvailable() do wait(0) end

	sampRegisterChatCommand('fracstream', activation)
	sampRegisterChatCommand('fz', activation)

    -- Кэширование глобальных функций локально ускоряет их вызов
    local _sampGetCharHandleBySampPlayerId = sampGetCharHandleBySampPlayerId
    local _doesCharExist = doesCharExist
    local _getCharModel = getCharModel
    local _renderFontDrawText = renderFontDrawText

    while true do 
        wait(0)
        imgui.Process = act.v
        if ienable.v then
            local rx = file.main.X
            local ry = file.main.Y

            if cursor then
                imgui.Process = false
                sampToggleCursor(true)
                rx, ry = getCursorPos()
                if wasKeyPressed(0x1) then
                    cursor = false
                    sampToggleCursor(false)
                    file.main.X, file.main.Y = rx, ry
                    imgui.Process = true
                end
            end

            -- Вычисляем математику и игроков только раз в 500 миллисекунд (снижение нагрузки в 60+ раз)
            local current_time = os.clock()
            if current_time - last_update_time > 0.5 then
                last_update_time = current_time
                p_count = 0
                for i, k in pairs(iconfig) do a_counts[i] = 0 end

                -- Получаем максимальный ID на сервере, чтобы не перебирать пустые до 1000
                local max_id = sampGetMaxPlayerId(true)
                local ped = playerPed
                
                for i = 0, max_id do
                    local res, char = _sampGetCharHandleBySampPlayerId(i)
                    if res and _doesCharExist(char) and char ~= ped then
                        p_count = p_count + 1
                        local skin = _getCharModel(char)
                        
                        -- O(1) поиск через предварительно собранную таблицу
                        local frac = skin_lookup[skin]
                        if frac and a_counts[frac] then
                            a_counts[frac] = a_counts[frac] + 1
                        end
                    end
                end
            end

            -- Отрисовка происходит каждый кадр, но использует уже подсчитанные данные
            _renderFontDrawText(font, 'Players: '..p_count, rx, ry, -1)
            local cur_y = ry + file.main.fsize + ( file.main.fsize / 2 )

            for frac_name, count in pairs(a_counts) do
                if count > 0 then 
                    _renderFontDrawText(font, frac_name..': '..count, rx, cur_y, 0xFF000000 + tonumber(file[frac_name].color, 16))
                    cur_y = cur_y + file.main.fsize + ( file.main.fsize / 2 )
                end
            end
        end
	end
end

