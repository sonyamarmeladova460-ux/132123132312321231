local function rgba_to_argb(clr)
	local a = bit.lshift(clr, 24)
	return bit.bor(bit.rshift(clr, 8), a)
end

local function updateConfig(file, old_font)
    local file = file or inicfg.load(nil, 'moonloader/fracstream.ini')
    -- Защита от пустого ини-файла
    if not file then file = { main = { fname = 'Arial', fsize = 9, fflag = 5, enable = false, X = 500, Y = 500 } } end

    local ifontname = imgui.ImBuffer(file.main.fname, 0x100)
    local ifontsize = imgui.ImInt(file.main.fsize)
    local ifontflag = imgui.ImInt(file.main.fflag)
    local ienable = imgui.ImBool(file.main.enable)
    local iconfig = {}

    -- Исправление утечки памяти (удаляем старый шрифт перед созданием нового)
    if old_font then renderReleaseFont(old_font) end
    local font = renderCreateFont(file.main.fname, file.main.fsize, file.main.fflag)

    skin_lookup = {} -- Очищаем кэш скинов

    for i, k in pairs(file) do
		if i ~= 'main' then
            iconfig[i] = { name = imgui.ImBuffer(i, 0x100) }
            for l, m in pairs(k) do 
                if l ~= 'color' then 
                    iconfig[i][l] = imgui.ImInt(m) 
                    -- Строим O(1) таблицу поиска скинов
                    skin_lookup[tonumber(m)] = i
                end 
            end
			iconfig[i].color = imgui.ImColor(tonumber(k.color:reverse(), 16)):GetVec4()
		end
    end
    return file, ifontname, ifontsize, ifontflag, ienable, iconfig, font
end

local file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig()

local x, y = getScreenResolution()
