function imgui.OnDrawFrame()
    imgui.SetNextWindowPos(imgui.ImVec2(x / 2, y / 2), imgui.Cond.FirstUseEver, imgui.ImVec2(0.5, 0.5))
    imgui.SetNextWindowSize(imgui.ImVec2(600, 300), imgui.Cond.FirstUseEver)
    imgui.Begin('FracStream by imring', act)
    imgui.BeginChild(1, imgui.ImVec2(imgui.GetWindowWidth()/5, 0), true)
    
    if imgui.Selectable(u8('Настройки')) then st = 'main' end
    imgui.Separator()
    for i, k in pairs(iconfig) do
        if imgui.Selectable(u8(i)) then st = i end
    end
    
    if imgui.Selectable(u8('Создать...')) then
        local a = math.random(1, 1000)
        while file['Random '..a] do a = math.random(1, 1000) end
        file['Random '..a] = { color = 'FFFFFF' }
        file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(file, font) -- Передаем старый шрифт
    end
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild(2, imgui.ImVec2(0, 0), false)
    
    if st == 'main' then
        if imgui.Checkbox(u8('Показать игроков'), ienable) then file.main.enable = ienable.v end
        if imgui.Button(u8('Изменить позицию')) then cursor = true end
        if imgui.Button(u8('Перезагрузить конфиг')) then file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(nil, font) end
        imgui.InputText(u8('Название шрифта'), ifontname)
        imgui.InputInt(u8('Размер шрифта'), ifontsize)
        imgui.InputInt(u8('Флаг шрифта'), ifontflag)
        if imgui.Button(u8('Применить шрифт')) then
            ienable.v = false
            file.main.fname = u8:decode(ifontname.v)
            file.main.fsize = u8:decode(ifontsize.v)
            file.main.fflag = u8:decode(ifontflag.v)
            renderReleaseFont(font)
            font = renderCreateFont(file.main.fname, file.main.fsize, file.main.fflag)
            ienable.v = true
        end
    elseif st then
        imgui.InputText(u8('Название'), iconfig[st].name)
        if imgui.ColorEdit3(u8('Цвет'), iconfig[st].color) then
			local clr = join_argb(0, iconfig[st].color.x * 255, iconfig[st].color.y * 255, iconfig[st].color.z * 255)
			file[st].color = ('%X'):format(clr)
        end
        imgui.Separator()
        for i, m in pairs(iconfig[st]) do
            if i ~= 'color' and i ~= 'name' then
                if imgui.InputInt('##'..i, m, 0) then
                    file[st][i] = m.v
                end
                imgui.SameLine()
                if imgui.Button(u8('Удалить##'..i)) then
                    file[st][i] = nil
                    file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(file, font)
                end
            end
        end
        if imgui.Button(u8('Добавить')) then
            file[st][#file[st] + 1] = 0
            file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(file, font)
        end
        imgui.Separator()
        if imgui.Button(u8('Применить настройки')) then
            local name = u8:decode(iconfig[st].name.v)
            if name ~= 'main' and name ~= st then
                file[name] = {}
                for i, k in pairs(file[st]) do file[name][i] = k end
                file[st] = nil
                st = name
            end
            file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(file, font)
        end
        imgui.SameLine()
        if imgui.Button(u8('Удалить')) then
            file[st] = nil
            st = nil
            file, ifontname, ifontsize, ifontflag, ienable, iconfig, font = updateConfig(file, font)
        end
    end
    imgui.EndChild()
    imgui.End()
end

function onScriptTerminate(scr)
	if scr == script.this then
		inicfg.save(file, 'moonloader/fracstream.ini')
	end
end


