local sampev = require 'samp.events'
local bit = require 'bit'

-- Локализация глобальных функций для максимальной скорости работы
local os_clock = os.clock
local string_format = string.format
local isCharInAnyCar = isCharInAnyCar
local storeCarCharIsInNoSave = storeCarCharIsInNoSave
local sampGetVehicleIdByCarHandle = sampGetVehicleIdByCarHandle
local sampGetPlayerNickname = sampGetPlayerNickname
local sampGetPlayerColor = sampGetPlayerColor
local sampAddChatMessage = sampAddChatMessage

local PLAYER_PED = PLAYER_PED
local myId = -1
local lastWarn = {}
local WARN_COOLDOWN = 0 -- Рекомендуется поставить кэш (например, 1 сек), чтобы не спамить в чат

local function getMyVehicleId()
    if not isCharInAnyCar(PLAYER_PED) then return nil end
    local car = storeCarCharIsInNoSave(PLAYER_PED)
    if not car or car == 0 then return nil end
    local ok, vid = sampGetVehicleIdByCarHandle(car)
    if ok and vid and vid >= 0 then return vid end
    return nil
end

local function getPlayerColorHex(pid)
    -- Убран тяжелый pcall ради производительности
    local col = sampGetPlayerColor(pid)
    if col then
        return string_format("{%06X}", bit.band(col, 0xFFFFFF))
    end
    return "{FFFFFF}"
end

function sampev.onBulletSync(playerId, data)
    -- Используем кэшированный ID вместо вызова функции на каждый выстрел в зоне стрима
    if playerId == myId then return end

    -- data.targetType и data.targetId уже являются числами в samp.events, tonumber не нужен
    if data.targetType == 2 and data.targetId == getMyVehicleId() then
        local now = os_clock()
        if WARN_COOLDOWN > 0 then
            local last = lastWarn[playerId]
            if last and (now - last < WARN_COOLDOWN) then
                return
            end
            lastWarn[playerId] = now
        end

        local nick = sampGetPlayerNickname(playerId) or "Unknown"
        local color = getPlayerColorHex(playerId)
        local msg = string_format("{ff4c5b}[Warning] %s%s[%d] {FFFFFF}выстрелил по т/с!", color, nick, playerId)

        sampAddChatMessage(msg, -1) 
    end
end

function main()
    repeat wait(0) until isSampAvailable()
    
    -- Получаем ID локального игрока один раз при запуске скрипта
    _, myId = sampGetPlayerIdByCharHandle(PLAYER_PED)

    while true do 
        wait(2000) -- Снижена частота работы основного потока
    end
end
