script_name('SensFix')
script_author('ChatGPT')
script_version('2.0')

require 'lib.moonloader'

local imgui = require('mimgui')
local memory = require('memory')
local inicfg = require('inicfg')

local CONFIG = 'sensfix.ini'

local SENS_X = 0xB6EC1C
local SENS_Y = 0xB6EC18

local originalX = nil
local originalY = nil

local settings = nil

local window = imgui.new.bool(false)
local enabled = imgui.new.bool(true)

local normal = imgui.new.float(0.003)
local aiming = imgui.new.float(0.0015)

local lastSens = nil
local restored = false

-- SAVE SETTINGS

local function saveSettings()
    if not settings then return end

    settings.main.enabled = enabled[0]
    settings.main.normal = normal[0]
    settings.main.aiming = aiming[0]

    inicfg.save(settings, CONFIG)
end

-- MOUSE SENSITIVITY

local function setSensitivity(value)
    memory.setfloat(SENS_X, value, false)
    memory.setfloat(SENS_Y, value, false)
end

local function restoreSensitivity()
    if originalX and originalY then
        memory.setfloat(SENS_X, originalX, false)
        memory.setfloat(SENS_Y, originalY, false)
    end
end

local function isAiming()
    if not doesCharExist(PLAYER_PED) then
        return false
    end

    local ptr = getCharPointer(PLAYER_PED)

    return memory.getint8(
        ptr + 0x528,
        false
    ) == 19
end

