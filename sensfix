-- IMGUI WINDOW

local frame = imgui.OnFrame(function()

    return window[0]

end, function()

    local resX, resY = getScreenResolution()

    imgui.SetNextWindowPos(
        imgui.ImVec2(resX / 2, resY / 2),
        imgui.Cond.FirstUseEver,
        imgui.ImVec2(0.5, 0.5)
    )

    imgui.SetNextWindowSize(
        imgui.ImVec2(480, 290),
        imgui.Cond.FirstUseEver
    )

    local flags =
        imgui.WindowFlags.NoResize +
        imgui.WindowFlags.NoCollapse

    if imgui.Begin(
        'SensFix | Settings',
        window,
        flags
    ) then

        -- ENABLE

        if imgui.Checkbox(
            'Enable SensFix',
            enabled
        ) then
            saveSettings()
        end

        imgui.Spacing()
        imgui.Separator()
        imgui.Spacing()

        -- NORMAL SENS

        imgui.Text('Normal sensitivity')

        imgui.PushItemWidth(-1)

        if imgui.SliderFloat(
            '##normal',
            normal,
            0.00001,
            0.05,
            '%.6f'
        ) then
            saveSettings()
        end

        imgui.PopItemWidth()

        imgui.Spacing()

        -- AIM SENS

        imgui.Text('Aiming sensitivity')

        imgui.PushItemWidth(-1)

        if imgui.SliderFloat(
            '##aim',
            aiming,
            0.00001,
            0.05,
            '%.6f'
        ) then
            saveSettings()
        end

        imgui.PopItemWidth()

        imgui.Spacing()
        imgui.Separator()
        imgui.Spacing()

        -- SAVE BUTTON

        if imgui.Button(
            'Save settings',
            imgui.ImVec2(-1, 0)
        ) then

            saveSettings()

            sampAddChatMessage(
                '[SensFix] Settings saved!',
                0x55FF55
            )

        end

        imgui.Spacing()

        -- CLOSE BUTTON

        if imgui.Button(
            'Close',
            imgui.ImVec2(-1, 0)
        ) then

            window[0] = false

        end

        -- WATERMARK

        local watermark = 'SensFix | v2.0'

        local textSize = imgui.CalcTextSize(
            watermark
        )

        local winSize = imgui.GetWindowSize()
        local style = imgui.GetStyle()

        imgui.SetCursorPos(
            imgui.ImVec2(
                winSize.x
                    - textSize.x
                    - style.WindowPadding.x,
                winSize.y
                    - textSize.y
                    - style.WindowPadding.y
            )
        )

        imgui.TextDisabled(watermark)

    end

    imgui.End()

end)

frame.LockPlayer = true
frame.HideCursor = false

-- MAIN

function main()

    while not isSampAvailable() do
        wait(100)
    end

    originalX = memory.getfloat(
        SENS_X, false
    )

    originalY = memory.getfloat(
        SENS_Y, false
    )

    local base = originalX

    if base < 0.00001 or base > 0.05 then
        base = 0.003
    end

    settings = inicfg.load({
        main = {
            enabled = true,
            normal = base,
            aiming = base * 0.5
        }
    }, CONFIG)

    enabled[0] =
        settings.main.enabled ~= false

    normal[0] = math.max(
        0.00001,
        math.min(
            0.05,
            tonumber(settings.main.normal) or base
        )
    )

    aiming[0] = math.max(
        0.00001,
        math.min(
            0.05,
            tonumber(settings.main.aiming) or base * 0.5
        )
    )

    saveSettings()

    sampRegisterChatCommand('sensfix', function()

        window[0] = not window[0]

    end)

    sampAddChatMessage(
        '[SensFix] Open menu: /sensfix',
        0x55FF55
    )

    while true do

        wait(0)

        if not enabled[0] then

            if not restored then
                restoreSensitivity()
                restored = true
            end

            lastSens = nil

        elseif not window[0]
            and not isPauseMenuActive()
            and not sampIsCursorActive()
            and doesCharExist(PLAYER_PED) then

            restored = false

            local value = normal[0]

            if isAiming() then
                value = aiming[0]
            end

            if value ~= lastSens then

                setSensitivity(value)

                lastSens = value

            end

        else

            lastSens = nil

        end

    end

end

-- SCRIPT TERMINATION

function onScriptTerminate(script, quitGame)

    if script == thisScript() then

        saveSettings()
        restoreSensitivity()

    end

end
